# Auto-detect text files
* text=auto

# Explicit LF line-ending normalization for source code, schemas, documents, and scripts
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.sql text eol=lf

# Windows PowerShell scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.ico binary
*.icns binary
*.pcap binary
*.pcapng binary
*.db binary
*.sqlite binary
*.tar.gz binary
*.zip binary
*.exe binary
*.dll binary
*.lib binary
