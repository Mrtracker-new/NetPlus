{
  "name": "@netpulse/components",
  "version": "0.1.0",
  "private": true,
  "description": "Disclosure-aware React components over the shared data model.",
  "license": "MIT OR Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.ts",
        "./src/index.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --environment jsdom --globals"
  },
  "dependencies": {
    "@netpulse/contract": "workspace:*",
    "@netpulse/design-system": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
